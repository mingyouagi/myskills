  "bugs": {
    "url": "https://github.com/mingyouagi/myskills/issues"
  },
  "homepage": "https://github.com/mingyouagi/myskills/tree/main/skills/skill-router#readme",
  "engines": {
    "node": ">=16.0.0"
  },
